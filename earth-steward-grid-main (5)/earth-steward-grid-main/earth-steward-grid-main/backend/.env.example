PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carboncredits

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Razorpay (use test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# AWS S3 (leave blank to use local disk storage in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=carboncredits-dev
AWS_REGION=ap-south-1

# SendGrid (leave blank to log emails to console in dev)
SENDGRID_API_KEY=

# Satellite NDVI API (leave blank to use mocked NDVI data in dev)
SATELLITE_API_KEY=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Email sender
FROM_EMAIL=noreply@carboncredits.gov.in
FROM_NAME=Carbon Credit Authority
